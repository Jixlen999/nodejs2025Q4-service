DATABASE_URL=postgresql://postgres:postgres@postgres:5432/home_library

APP_PORT=4000
APP_NAME=home-library-rest-service
NETWORK_NAME=home-library-network

POSTGRES_VERSION=15
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=home_library
POSTGRES_PORT=5432
POSTGRES_HOST=postgres_db
POSTGRES_HEALTHCHECK_INTERVAL=5s
POSTGRES_HEALTHCHECK_TIMEOUT=2s
POSTGRES_HEALTHCHECK_RETRIES=20
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3

# error, warn, log, debug, verbose
LOG_LEVEL=log
LOG_MAX_FILE_SIZE_KB=10


CRYPT_SALT=10
JWT_SECRET_KEY=secret123123
JWT_SECRET_REFRESH_KEY=secret123123
TOKEN_EXPIRE_TIME=1h
TOKEN_REFRESH_EXPIRE_TIME=24h